int CalculateInteractionScore(int[] players)
{
    int score = 0;                                                                       //  = es 1                                                         => 1
    for (int i = 0; i < players.Length; i++)                                             //  = es 1, players.Length es N + 1, i++ es 1                      => 1 + N + 1 + 1
    {
        for (int j = i + 1; j < players.Length; j++)                                     //  = es 1, + es 1, i es N, players.Length es N + 1, j++ es 1      => 1 + 1 + N + N + 1 + 1
            {
              int interaction = players[i] + players[j];                                 //  = es 1, players[i] es N, + es 1, players[j] es N               => 1 + N + 1 + N
              score += interaction;                                                      //  = es 1, + es 1                                                 => 1 + 1
            }
      }
return score;
}

